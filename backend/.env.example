# ---------- App ----------
APP_NAME=AgentForge
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = JSON logs (production), false = pretty console logs
LOG_JSON=false
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- LLM (any OpenAI-compatible API) ----------
# OpenAI:  leave OPENAI_BASE_URL empty
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Together:OPENAI_BASE_URL=https://api.together.xyz/v1
# Ollama:  OPENAI_BASE_URL=http://host.docker.internal:11434/v1  (OPENAI_API_KEY=ollama)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
# Models offered in the agent builder dropdown (JSON list)
AVAILABLE_MODELS=["gpt-4o-mini","gpt-4o","gpt-4.1-mini"]

# ---------- Data stores ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agentforge
REDIS_URL=redis://localhost:6379/0
# Leave CHROMA_HOST empty to use an embedded on-disk ChromaDB at CHROMA_PERSIST_DIR
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data

# ---------- RAG ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
MMR_LAMBDA=0.5
PRELOAD_EMBEDDING_MODEL=false

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Limits ----------
RATE_LIMIT_PER_MINUTE=10
CONVERSATION_CACHE_SIZE=20
EMBEDDING_CACHE_TTL_SECONDS=3600
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CODE_EXEC_TIMEOUT_SECONDS=10
API_CALL_TIMEOUT_SECONDS=15
# Allow the json_api_call tool to reach localhost / private IPs (SSRF risk; dev only)
ALLOW_PRIVATE_NETWORK_API_CALLS=false
